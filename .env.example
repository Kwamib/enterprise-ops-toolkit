# =============================================================================
# Enterprise Operations Control Script - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Database Configuration
DB_NAME=MYDB
DB_CONNECT_STRING="user/password"
DB_SCHEMA_PREFIX=OPS

# Remote Server Configuration
REMOTE_HOST=your-server.example.com
REMOTE_USER=oracle
PEM_FILE_PATH=/path/to/your-key.pem
REMOTE_DB_NAME=REMOTEDB
REMOTE_IMPORT_DIR=/backup/datapump/import

# Directory Configuration
SCRIPTS_DIR=/opt/scripts
SCRIPT_HOME=/opt/scripts/bin
LOG_DIR=/backup/datapump/MYDB

# Alert Configuration
ALERT_EMAIL=admin@example.com
